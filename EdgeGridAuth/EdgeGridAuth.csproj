<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Akamai.EdgeGrid.Auth</RootNamespace>
    <AssemblyName>Akamai.EdgeGrid.Auth</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    
    <!-- NuGet Package Metadata -->
    <PackageId>Akamai.EdgeGrid.Auth</PackageId>
    <Version>1.0.0</Version>
    <Title>Akamai EdgeGrid Authentication Library</Title>
    <Authors>Akamai Technologies</Authors>
    <Copyright>Copyright 2026 Akamai Technologies, Inc. All rights reserved.</Copyright>
    <Description>Official Akamai EdgeGrid authentication library for .NET 10.0 and .NET 11.0. Provides signing and authentication for Akamai APIs with automatic redirect handling and environment variable credential support.</Description>
    <PackageProjectUrl>https://github.com/akamai/AkamaiOPEN-edgegrid-C-Sharp</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/akamai/AkamaiOPEN-edgegrid-C-Sharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>akamai;edgegrid;authentication;api;http</PackageTags>
    <PackageReleaseNotes>Stable release version 1.0.0 - Supports .NET 10.0 and .NET 11.0; drops .NET 8.0 and .NET 9.0 support. Includes automatic redirect handling, environment variable credential loading, and extensive test coverage.</PackageReleaseNotes>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

</Project>